# ─── Upstream Proxy Mode ───────────────────────────
# Options:
#   sub    - Subscription URL from SUB_URL (Xray/V2Ray JSON, sing-box JSON, or URI list)
#   uri    - Single proxy config URI from PROXY_URI (vless://, vmess://, trojan://, ss://)
#   direct - No upstream proxy; route directly through SSH exit node
PROXY_MODE=sub

# Subscription URL (used when PROXY_MODE=sub)
SUB_URL=https://sub.example.com/json/YOUR_TOKEN
# URL-test interval for picking the fastest node in a subscription (e.g. 30s, 5m, 1h)
SUB_TEST_INTERVAL=5m

# Single proxy URI (used when PROXY_MODE=uri)
# PROXY_URI=vless://uuid@example.com:443?security=reality&sni=example.com&pbk=...&sid=...&fp=chrome#node

# ─── SSH Tunnel (final exit node) ──────────────────
# ⚠️  WARNING: SSH exit is ALWAYS enabled by default (SSH_ENABLED=true).
# Setting SSH_ENABLED=false disables the SSH exit hop (direct exit) and WILL LEAK
# your real IP (especially with PROXY_MODE=direct). Leave commented unless you understand the risk.
# SSH_ENABLED=true
SSH_HOST=1.2.3.4
SSH_PORT=22
SSH_USER=root
SSH_KEY_FILE=~/.ssh/id_rsa

# ─── Proxy ─────────────────────────────────────────
SOCKS_PORT=1080

# ─── T3 Code ───────────────────────────────────────
# Single host directory persisting all agent data, skills, plugins, configs & T3 state (/home/node)
DATA_DIR=./data
# Local-only port (127.0.0.1) for T3 Code web UI
T3_PORT=3773
# Local-only port (127.0.0.1) for live container browser screen (noVNC)
BROWSER_PORT=6080
# Max CPUs for the t3code container (e.g. 2 or 1.5). 0 = no limit
T3_CPUS=0
# Base URL used in pairing (login) links (defaults to http://localhost:<T3_PORT>)
# T3_PUBLIC_URL=http://localhost:3773
# Default lifetime of `make pair` links (5m, 1h, 30d, ...)
T3_PAIRING_TTL=1h

# ─── Coding Agents (optional) ──────────────────────
# Claude Code token from `claude setup-token` (starts with sk-ant-oat01-).
# Leave empty to use the login stored in ./data/claude (make claude-login)
CLAUDE_CODE_OAUTH_TOKEN=
# Alternative: ANTHROPIC_API_KEY=

# Codex API key. Leave empty to log in with ChatGPT instead (make codex-login)
OPENAI_API_KEY=

# ─── Workspace Environment ─────────────────────────
TZ=Europe/Helsinki
WORKSPACE_LANG=en_US.UTF-8
WORKSPACE_TERM=xterm-256color

# ─── Git Identity ──────────────────────────────────
GIT_USER_NAME=your-name
GIT_USER_EMAIL=you@example.com

# ─── Projects ──────────────────────────────────────
# Comma-separated host paths (mounted to /workspace/<folder-name>)
# Optional custom mount name: /path/to/dir:custom-name
PROJECTS=./projects
