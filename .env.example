# ─── Subscription (Xray JSON from Sanaei panel) ───
SUB_URL=https://sub.example.com/json/YOUR_TOKEN

# ─── SSH Tunnel (final exit node) ──────────────────
SSH_HOST=1.2.3.4
SSH_PORT=22
SSH_USER=root
SSH_KEY_FILE=~/.ssh/id_rsa

# ─── Proxy ─────────────────────────────────────────
SOCKS_PORT=1080

# ─── Workspace Environment ─────────────────────────
TZ=Europe/Helsinki
WORKSPACE_LANG=en_US.UTF-8
WORKSPACE_TERM=xterm-256color

# ─── Git Identity ──────────────────────────────────
GIT_USER_NAME=your-name
GIT_USER_EMAIL=you@example.com

# ─── Projects ──────────────────────────────────────
# Comma-separated host paths (mounted to /workspace/<folder-name>)
# Optional custom mount name: /path/to/dir:custom-name
PROJECTS=./projects
